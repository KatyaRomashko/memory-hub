# --- proxy ---
LITELLM_MASTER_KEY=sk-poc-local
POC_MODEL=gemini/gemini-2.5-flash
POC_MODEL_API_KEY=            # see ~/.secrets (GEMINI_API_KEY)
ANTHROPIC_API_KEY=            # only for the Claude Code scenario

# --- capture ---
MEMORYHUB_CAPTURE_SINK=jsonl              # jsonl | memoryhub
MEMORYHUB_CAPTURE_EXTRACT_EVERY=0         # >0: run extraction every N user turns
MEMORYHUB_CAPTURE_TOOLS=false             # also append tool_call/tool_result messages
MEMORYHUB_CAPTURE_IGNORE_MODELS=          # regex, e.g. haiku (Claude Code side calls)
MEMORYHUB_CAPTURE_SCOPE=user
MEMORYHUB_CAPTURE_OBSERVATIONS=./out/observations.jsonl
MEMORYHUB_CAPTURE_THREADS_LOG=./out/threads.jsonl

# Extraction override for `verify.py extract` / EXTRACT_EVERY.
# The MCP server still needs MEMORYHUB_CONV_EXTRACTION_API_KEY on-cluster;
# these only supply model + OpenAI-compatible URL (no /chat/completions suffix).
MEMORYHUB_CAPTURE_EXTRACT_MODEL=
MEMORYHUB_CAPTURE_EXTRACT_MODEL_URL=

# --- MemoryHub (sink=memoryhub); see ~/.config/memoryhub/credentials ---
MEMORYHUB_URL=
MEMORYHUB_API_KEY=
